# Application
APP_NAME="SaaS Admin Dashboard"
DEBUG=false

# Database (MySQL)
DATABASE_URL=mysql+aiomysql://saas_user:saas_password@localhost:3306/saas_dashboard

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-random-64-character-string
CSRF_SECRET=change-this-to-a-different-random-string

# Token settings
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business rules
LOW_STOCK_THRESHOLD=10
ITEMS_PER_PAGE=20
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
