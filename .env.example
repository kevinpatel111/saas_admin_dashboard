# ==============================================================================
# SaaS Admin Dashboard - Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env on the server and substitute real, secure values.
# NEVER commit the actual .env file with real credentials to Git!

# --- Application Settings ---
APP_NAME="SaaS Admin Dashboard"
DEBUG=false
UVICORN_WORKERS=2

# --- MySQL Database Configuration ---
# Used by both MySQL container and FastAPI application container
MYSQL_DATABASE=saas_dashboard
MYSQL_USER=saas_user
MYSQL_PASSWORD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# Database URL used by the FastAPI app inside Docker Compose:
# mysql+aiomysql://<user>:<password>@db:3306/<database>
DATABASE_URL=mysql+aiomysql://${MYSQL_USER}:${MYSQL_PASSWORD}@db:3306/${MYSQL_DATABASE}

# --- Cryptographic Security Keys ---
# Generate using: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_64_character_random_secret_key
CSRF_SECRET=replace_with_different_64_character_random_csrf_key

# --- Cookie Security Settings ---
# Set to 'false' if testing via raw IP HTTP; set to 'true' once HTTPS / SSL is active
COOKIE_SECURE=false

# --- Session & Rate Limiting Rules ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOW_STOCK_THRESHOLD=10
ITEMS_PER_PAGE=20
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
